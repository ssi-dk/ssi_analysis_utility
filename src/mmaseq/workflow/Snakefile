from mmaseq.utils.PATH import *
from mmaseq.utils import logging_setup, helpers, sample_config, result_paths, results_aggregator
from pathlib import Path
import pandas as pd
import re

# Initiate logging
###################################################################
logger = logging_setup.initiate_log("MMAseq Pipeline")
logging_setup.adjust_log(logger, int(config["verbosity"]))

logger.info("Setting up pipeline variables")
logger.debug("Importing user input from config file")


# Read user input
###################################################################
samplesheet_path = Path(config["samplesheet"])
outdir = Path(config["outdir"])
ignore_assemblies = config["ignore_assemblies"]
deploy_dir = Path(config["deploy_dir"])
spe_configs_dir = Path(config["spe_configs_dir"])

logger.trace(("User input (by config):\n"
    f" - samplesheet_path: {samplesheet_path}"
    f" - deploy_dir: {deploy_dir}"
    f" - outdir: {outdir}"))

# Deduce variables
###################################################################
logdir = outdir / "Logs"
database_dir = deploy_dir / "Databases"
logger.trace(("Deduced variables:\n"
    f" - logdir: {logdir}"
    f" - database_dir: {database_dir}"))


# Read config files
#################################################################
logger.debug("Creating sample specific input and output objects")
logger.trace("Reading samplesheet")
samplesheet = pd.read_csv(samplesheet_path, 
                          sep='\t').set_index("sample_name")

logger.trace("Defining sample specific configurations")
sample_configs = sample_config.determine_sample_configs(samplesheet, 
                                                           spe_configs_dir, 
                                                           ignore_assemblies)

all_result_files = result_paths.define_all_result_files(outdir,
                                                            sample_configs,
                                                            raw=False)

# The raw path of a result is now derived by rule copy from its final path,
# so the raw list is no longer needed here.
all_result_filepaths = [
    path
    for sample in all_result_files.values()
    for files in sample.values()
    for path in files
]

long_table = outdir / "results_long.tsv"


# Wildcard values accepted by rule copy, taken from the expected results rather
# than from a loose pattern. Without these constraints the copy pattern would
# also match its own `raw/` input (infinite recursion) and the output of rule
# assembly (ambiguity).
copy_samples = sorted(all_result_files)
copy_relpaths = sorted({
    str(Path(path).relative_to(outdir / sample))
    for sample, modules in all_result_files.items()
    for files in modules.values()
    for path in files
})


def alternation(values):
    """Regex matching exactly `values`. '$^' is used to never match."""
    return "|".join(re.escape(str(value)) for value in values) if values else "$^"


def write_long_table(result_files, destination):
    """
    Aggregate every result file that exists into the long table.

    Called both by rule table (all modules succeeded) and by the onerror
    handler (some did not), so a partially failed run still yields a
    results_long.tsv covering the modules that did complete.
    """
    results_long = results_aggregator.generate_long_results(result_files)
    results_long.to_csv(destination, sep = "\t", index = False)

    return destination


#################################
logger.info("Initiating pipeline")

# One job per result file. Copying used to be a single job over the full list,
# which meant one failed module left every other result uncopied.
rule copy:
    input:
        raw = f"{outdir}/{{sample}}/raw/{{relpath}}"
    output:
        result = f"{outdir}/{{sample}}/{{relpath}}"
    wildcard_constraints:
        sample = alternation(copy_samples),
        relpath = alternation(copy_relpaths)
    message:
        "[copy]: Copying {wildcards.relpath} for {wildcards.sample}"
    shell:
        """
        mkdir -p $(dirname {output.result})
        cp -f {input.raw} {output.result}
        """

rule versions:
    input:
        deploy_dir = deploy_dir
    output:
        versions_file = outdir / "Conda_tools_version.tsv"
    message:
        "[versions]: Conda versions are being determined and written to {output.versions_file}"
    script:
        SCRIPTS_DIR / "versions.py"



rule table:
    input:
        files = all_result_filepaths,
        versions = rules.versions.output.versions_file
    params:
        results_dict = all_result_files
    output:
        long = long_table
    log:
        stdout = "%s/table.log" %logdir
    message:
        "[table]: Generating long table"
    run:
        write_long_table(params.results_dict, output.long)


rule clean:
    input:
        long = rules.table.output.long
    params:
        outdir = outdir
    log:
        stdout = "%s/clean.log" %logdir
    message:
        "[clean_results]: Removing intermediate folders"
    shell:
        """
        echo "Removing raw result folders under {params.outdir}" > {log.stdout} 2>&1

        find {params.outdir} -mindepth 2 -maxdepth 2 -type d -name raw \
            -exec rm -r {{}} + >> {log.stdout} 2>&1
        """


# rule table only runs once every expected result exists, so a crashed module
# would otherwise mean no long table at all. Aggregate what did complete
# instead. The run still exits non-zero - this recovers results, it does not
# hide the failure.
onerror:
    logger.warning(
        "Pipeline finished with errors. Aggregating the results that did "
        "complete; modules that failed are absent from the long table."
    )

    try:
        write_long_table(all_result_files, long_table)
        logger.warning(f"Partial results were written to {long_table}")
    except Exception as error:
        logger.error(f"Could not write partial results to {long_table}:\n{error}")


include : "rules/Databases.smk"
include : "rules/Single_Reads.smk"
include : "rules/Paired_Reads.smk"
include : "rules/Analysis.smk"
